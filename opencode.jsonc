{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "architect",
  "agent": {
    "architect": {
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "description": "Umbrello Rust Architect",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "implementer": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "description": "Umbrello Rust Implementer",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "explorer": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "description": "Umbrello Rust Codebase Explorer",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    },
    "reviewer": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "description": "Umbrello Rust Independent Reviewer",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    }
  }
}
